<?xml version="1.0" encoding="utf-8"?>
<!--
  iLayoutSettings — LSPosed module for HyperOS 3 Settings (v16.6).
  Reorders the native header list, adds conditional iOS cards (software update,
  connected headset, iCloud) and swaps the app identity to iLayoutSettings.
  Nothing is redrawn by the module.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.Remo.ilayoutsettings"
    android:versionCode="98"
    android:versionName="16.7">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".PrefsProvider"
            android:authorities="com.Remo.ilayoutsettings.prefs"
            android:exported="true" />

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="首页入口重排 + 条件卡片（软件更新/耳机/iCloud）+ 底部搜索栏（iOS 27 液态玻璃、G2 圆角、上下光边、点麦克风唤醒小爱）+ 顶栏透明度/发丝线；背景、行样式、点击全部保持澎湃原生。" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />
        <!-- Lets LSPosed serve the module's shared prefs to the hooked process,
             so the sliders work without a world-readable prefs file. -->
        <meta-data android:name="xposedsharedprefs" android:value="true" />
    </application>
</manifest>
